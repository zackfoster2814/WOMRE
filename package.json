{
  "name": "womre",
  "version": "1.0.0",
  "main": "dist-electron/electron/main.js",
  "scripts": {
    "dev:vite": "vite",
    "dev:electron": "cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .",
    "dev": "concurrently \"npm run dev:vite\" \"npm run dev:electron\"",
    "build:ts": "tsc -p electron/tsconfig.json",
    "build:web": "vite build",
    "build": "npm run build:ts && npm run build:web",
    "build-electron": "npm run build && electron-builder",
    "dist": "npm run build && electron-builder --publish=never",
    "pack": "npm run build && electron-builder --dir",
    "portable": "npm run build && electron-builder --win --dir",
    "rebuild": "electron-rebuild",
    "postinstall": "electron-builder install-app-deps"
  },
  "author": "Your Name",
  "license": "MIT",
  "description": "Womre Application",
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.12",
    "@types/lodash": "^4.17.20",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.8",
    "@vitejs/plugin-react": "^5.0.1",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.2.1",
    "cross-env": "^10.0.0",
    "electron": "^37.3.1",
    "electron-builder": "^26.0.12",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.12",
    "tailwindcss-animate": "^1.0.7",
    "terser": "^5.36.0",
    "ts-node": "^10.9.2",
    "tw-animate-css": "^1.3.2",
    "typescript": "^5.9.2",
    "vite": "^7.1.3"
  },
  "build": {
    "appId": "com.womre.app",
    "productName": "Womre",
    "directories": {
      "output": "dist-app"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "node_modules/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "dir",
          "arch": [
            "x64"
          ]
        }
      ]
    }
  },
  "dependencies": {
    "dotenv": "^17.2.1",
    "pg-hstore": "^2.3.4",
    "react": "^19.1.1",
    "react-audio-player": "^0.17.0",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.8.2",
    "sequelize": "^6.37.7",
    "sequelize-auto": "^0.8.8",
    "sequelize-cli": "^6.6.3",
    "sqlite3": "^5.1.7"
  }
}
