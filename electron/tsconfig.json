{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "lib": ["ES2020"],
    "outDir": "../dist-electron",
    "rootDir": "..",
    "noEmit": false,
    "jsx": "preserve",
    "moduleResolution": "bundler",
    "declaration": false,
    "declarationMap": false,
    "sourceMap": true,
    "allowImportingTsExtensions": false,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "strict": false,
    "noImplicitAny": false,
    "types": ["node"],
    "paths": {
      "@/*": ["../src/*"]
    }
  },
  "include": ["**/*.ts", "../src/db/**/*.ts", "../src/utils/**/*.ts"],
  "exclude": [
    "../node_modules",
    "../dist",
    "../dist-electron",
    "../src/utils/wheelUtils.ts"
  ]
}
